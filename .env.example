# MomPill 환경변수 템플릿
# 이 파일을 복사해 .env로 만든 후 실제 값을 채워 넣으세요.
# .env 파일은 절대 git에 커밋하지 마세요.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
GEMINI_API_KEY=your-gemini-api-key-here
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project
COUPANG_TRACKING_ID=your-coupang-tracking-id
# 카카오 로그인은 Supabase OAuth로 처리 — 앱 키 불필요 (Supabase 대시보드에 REST API 키 등록)
POSTHOG_API_KEY=your-posthog-api-key

# ↓ 아래 두 값은 Flutter .env가 아닌 Supabase Secrets에 등록 (대시보드 > Settings > Edge Function Secrets)
# COUPANG_ACCESS_KEY=06586e03-85f9-4340-8287-8c212dd06461
# COUPANG_SECRET_KEY=your-coupang-secret-key
# COUPANG_TRACKING_ID=your-coupang-tracking-id  (Edge Function에서도 동일 값 등록 필요)
